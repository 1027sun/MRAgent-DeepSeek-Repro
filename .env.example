# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#
# ============================== 1) Chat 端点 ==============================
# 默认走 DeepSeek（OpenAI 兼容）。换成任何 OpenAI 兼容服务只需改这三行。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在此填入你的DeepSeekKey
MODEL_DEEPSEEK=deepseek-flash
#
# 想用回 OpenRouter 就改成：
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-xxxxxxxx
#   MODEL_DEEPSEEK=google/gemini-2.5-flash
#
# 模型别名可用 MODEL_<名字大写> 覆盖，例如 MODEL_GEMINI=xxx。
# 不在别名表里的名字会原样透传，所以 --model deepseek-flash 直接可用。

# ========================= 2) 各家服务的参数怪癖 =========================
# DeepSeek 默认开启 thinking 模式，思维链按「输出 token」计费，会让成本翻几倍；
# 而且 thinking 模式下 temperature 会被忽略。必须显式关闭。
# DeepSeek 也不支持 seed / parallel_tool_calls，需要剔除这两个请求参数。
# 用 OpenRouter 时这两行留空即可。
LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
LLM_DROP_PARAMS=seed,parallel_tool_calls

# ============================== 3) Embedding ==============================
# local = 本地 sentence-transformers（免费、离线、不需要 key）—— 本项目使用
# api   = OpenAI 兼容的 /embeddings 端点
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=BAAI/bge-base-en-v1.5
LOCAL_EMBED_DEVICE=cpu
LOCAL_EMBED_BATCH=64
#
# 模型缓存目录与镜像。huggingface.co 在国内直连会超时，必须用 hf-mirror。
HF_HOME=./hf_cache
HF_ENDPOINT=https://hf-mirror.com
#
# BGE 系列要求查询侧加指令前缀（只加查询、不加文档）：
BGE_QUERY_PREFIX=Represent this sentence for searching relevant passages:
#
# 改用 API embedding 时：
#   EMBED_BACKEND=api
#   EMBED_BASE_URL=https://openrouter.ai/api/v1
#   EMBED_API_KEY=sk-or-v1-xxxxxxxx
#   EMBED_MODEL=text-embedding-3-large

# ================================ 4) Judge ================================
# 留空则复用上面的 LLM_* 设置
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-v4-pro

# ================================ 5) 其他 =================================
# 每次 API 调用的 token 用量会追加到这个 JSONL，用于核对成本
# USAGE_LOG=log/locomo/token_usage.jsonl
